{
  "name": "trading-bot",
  "version": "1.0.0",
  "description": "Paper-trading bot (no live trading) using real public market data and an MA-crossover strategy.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "scan": "ts-node src/index.ts scan",
    "replay:raw": "ts-node src/index.ts replay:raw",
    "replay:memory": "ts-node src/index.ts replay:memory",
    "memory:reset": "ts-node src/index.ts memory:reset",
    "broker:check": "ts-node src/index.ts broker:check",
    "broker:preview": "ts-node src/index.ts broker:preview",
    "daily": "ts-node src/index.ts daily",
    "daily:reset": "ts-node src/index.ts daily:reset",
    "lab:backtest": "ts-node src/index.ts lab:backtest",
    "lab:tournament": "ts-node src/index.ts lab:tournament",
    "lab:plateau": "ts-node src/index.ts lab:plateau",
    "lab:walkforward": "ts-node src/index.ts lab:walkforward",
    "test": "node --test --require ts-node/register test/*.test.ts",
    "ui": "ts-node src/index.ts ui"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
