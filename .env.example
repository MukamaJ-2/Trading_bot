# Copy this file to .env and adjust as needed. Everything here is optional -
# sensible paper-trading defaults are baked in if a variable is left unset.
#
# There is no broker/exchange API key in this file, on purpose: this bot has
# no live trading path and never needs a real account credential to run.

# Market
# Coinbase Exchange's public candles endpoint - chosen because it doesn't block
# cloud/datacenter IPs the way Binance's public API does (Binance returns HTTP 451
# for GitHub Actions, Vercel, AWS, etc. - it's an exchange-side restriction, not
# something this bot works around).
SYMBOL=BTC-USD
INTERVAL=5m
MARKET_DATA_BASE_URL=https://api.exchange.coinbase.com

# Optional: switch to Alpaca's market data API instead of Coinbase (e.g. for stock
# symbols like AAPL, or crypto pairs in Alpaca's own format like BTC/USD). Unlike
# Coinbase, Alpaca requires an API key even for read-only market data - get one free
# at https://alpaca.markets, then fill these in locally.
# NEVER commit real values here or paste them into chat - this file is a template.
# MARKET_DATA_PROVIDER=alpaca
# SYMBOL=BTC/USD
ALPACA_API_KEY_ID= PKTTWGDAU2UBZRKCWDHMEAFESE
# ALPACA_API_SECRET_KEY=
# ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Optional: also let `npm run scan` actually submit orders to Alpaca's PAPER trading
# simulator (never live - src/brokerAlpaca.ts hardcodes the paper endpoint, it is not
# configurable). Requires ALPACA_API_KEY_ID/ALPACA_API_SECRET_KEY above. Run
# `npm run broker:check` then `npm run broker:preview` before ever setting this.
# BROKER=alpaca

# Strategy
FAST_MA_PERIOD=9
SLOW_MA_PERIOD=21

# Risk
TRADE_QUANTITY=0.01
MAX_POSITION=0.05
STOP_LOSS_PCT=2
TAKE_PROFIT_PCT=4
MAX_DAILY_LOSS_PCT=5

# Data windows
SCAN_CANDLE_LIMIT=100
REPLAY_CANDLE_LIMIT=1000
REPLAY_LOOKAHEAD_CANDLES=12
