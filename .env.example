# Copy this file to .env and adjust as needed. Everything here is optional -
# sensible paper-trading defaults are baked in if a variable is left unset.
#
# There is no broker/exchange API key in this file, on purpose: this bot has
# no live trading path and never needs a real account credential to run.

# Market
# Coinbase Exchange's public candles endpoint - chosen because it doesn't block
# cloud/datacenter IPs the way Binance's public API does (Binance returns HTTP 451
# for GitHub Actions, Vercel, AWS, etc. - it's an exchange-side restriction, not
# something this bot works around).
SYMBOL=BTC-USD
INTERVAL=5m
MARKET_DATA_BASE_URL=https://api.exchange.coinbase.com

# Optional: switch to Alpaca's market data API instead of Coinbase (e.g. for stock
# symbols like AAPL, or crypto pairs in Alpaca's own format like BTC/USD). Unlike
# Coinbase, Alpaca requires an API key even for read-only market data - get one free
# at https://alpaca.markets, then fill these in locally.
# NEVER commit real values here or paste them into chat - this file is a template.
# MARKET_DATA_PROVIDER=alpaca
# SYMBOL=BTC/USD
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
# ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Optional: also let `npm run scan` actually submit orders to Alpaca's PAPER trading
# simulator (never live - src/brokerAlpaca.ts hardcodes the paper endpoint, it is not
# configurable). Requires ALPACA_API_KEY_ID/ALPACA_API_SECRET_KEY above. Run
# `npm run broker:check` then `npm run broker:preview` before ever setting this.
# BROKER=alpaca

# Strategy 1: MA crossover
FAST_MA_PERIOD=9
SLOW_MA_PERIOD=21

# Confirmation filters shared by all three strategies below, for fewer but higher-conviction
# trades. A raw crossover/reversal only becomes a real BUY/SELL if price is on the right side
# of the trend MA (not applied to the RSI strategy - see below) AND volume is a real spike
# (>= volume multiplier x the recent average), not noise.
TREND_MA_PERIOD=50
VOLUME_LOOKBACK=20
VOLUME_MULTIPLIER=1.5

# Strategy 2: MACD crossover (MACD line crossing its own signal line), confirmed the same way
# as the MA crossover above.
MACD_FAST_PERIOD=12
MACD_SLOW_PERIOD=26
MACD_SIGNAL_PERIOD=9

# Strategy 3: RSI mean-reversion (a real reversal out of oversold/overbought), confirmed by
# volume only - no trend filter, since a reversal signal is expected to go against the trend.
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# Risk
TRADE_QUANTITY=0.01
MAX_POSITION=0.05
STOP_LOSS_PCT=2
TAKE_PROFIT_PCT=4
MAX_DAILY_LOSS_PCT=5

# Data windows
SCAN_CANDLE_LIMIT=100
REPLAY_CANDLE_LIMIT=1000
REPLAY_LOOKAHEAD_CANDLES=12

# ---------------------------------------------------------------------------------------
# Daily bot + Backtest Lab ("The Backtest Machine": npm run daily, npm run lab:*)
# Daily candles only, signals on the 00:00 UTC close, fills on the next open. Paper only.
# ---------------------------------------------------------------------------------------
DAILY_SYMBOL=BTC-USD
# Strategy name (ema_cross, ema_cross_regime, sma_cross, supertrend, donchian, macd,
# price_sma, rsi_reversion) and optional parameter overrides like fast=9,slow=21.
DAILY_STRATEGY=ema_cross
# DAILY_PARAMS=fast=9,slow=21
# Size of the paper account (the capital cap). Every entry uses 100% of it, like the backtest.
PAPER_CAPITAL=100000
COMMISSION_PCT=0.1
SLIPPAGE_PCT=0

# Optional Telegram alerts (signal + daily heartbeat). Fill these in .env or GitHub
# secrets ONLY - never here, never in chat.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
