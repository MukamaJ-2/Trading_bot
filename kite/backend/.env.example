# Copy to kite/backend/.env (git-ignored). No credentials go here: you log in from
# the browser, and the backend keeps the access token in state/kite_session.json.

# true = synthetic market data and a fake account, no Zerodha account needed.
KITE_DEMO=false

# Calendar days of daily candles served by /api/scanner-data.
SCANNER_HISTORY_DAYS=120

# Seconds between Kite historical-data calls (Kite allows about 3 per second).
HISTORICAL_MIN_INTERVAL_SEC=0.35

# Where the session, caches and dummy GTT records are stored.
# KITE_STATE_DIR=./state

# Allowed browser origins (the Vite dev server by default).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
